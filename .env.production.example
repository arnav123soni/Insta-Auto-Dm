# ==============================================================================
# OpenReply Production Environment Configuration (.env)
# Oracle Cloud VM Deployment alongside existing Chemical CRM
# ==============================================================================

# ── 1. App Domain & Security ──────────────────────────────────────────────────
# Set this to your production HTTPS domain or subdomain (e.g., https://dm.yourdomain.com)
NEXTAUTH_URL=https://dm.yourdomain.com

# Port exposed to local Nginx on the host (defaults to 3001 to avoid clashing with 3000)
WEB_PORT=3001

# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=generate_strong_secret_via_openssl_rand_hex_32
CRON_SECRET=generate_strong_secret_via_openssl_rand_hex_32

# MUST be an exact 64-character hex string (32 bytes).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=generate_64_char_hex_key_via_openssl_rand_hex_32

# ── 2. Isolated Production PostgreSQL ─────────────────────────────────────────
POSTGRES_USER=openreply_user
POSTGRES_PASSWORD=set_a_secure_database_password_here
POSTGRES_DB=openreply_db

# ── 3. Meta / Instagram App Credentials ───────────────────────────────────────
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your_meta_app_id
INSTAGRAM_APP_SECRET=your_meta_app_secret
FACEBOOK_APP_SECRET=your_facebook_app_secret
WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token

# ── 4. Initial Workspace Owner / Dev Bypass (Optional) ───────────────────────
# If set, automatically logs in as this owner without needing email magic links.
# Set RUN_SEED=true to seed this user and workspace upon container first boot.
RUN_SEED=true
LOCAL_OWNER_ID=owner-prod-id
LOCAL_OWNER_EMAIL=admin@yourdomain.com
LOCAL_OWNER_NAME=Admin

# ── 5. Email Magic Links (Optional, if not using LOCAL_OWNER bypass) ─────────
# RESEND_API_KEY=re_...
# EMAIL_FROM=OpenReply <notifications@yourdomain.com>
# ALLOWED_EMAILS=admin@yourdomain.com

# ── 6. External Notifications & Integrations (Optional) ──────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=
